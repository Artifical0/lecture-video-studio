# 录课视频工坊配置。复制为 .env 后修改：cp .env.example .env
# 路径可用 $HOME；不填的项用括号里的默认值（相对仓库根目录）。

# ---- 网页 ----
LVS_PASSWORD=change-me            # 访问密码（共享给同事）
LVS_SECRET=                       # 随机字符串，用于登录 cookie 签名；install.sh 会自动生成
LVS_HOST=0.0.0.0                  # 只在本机用改成 127.0.0.1
LVS_PORT=8095
# LVS_DATA=data                   # 任务和音色数据目录（data）

# ---- Python 环境（install.sh 默认建在 envs/ 下） ----
# LVS_PY_MAIN=envs/main/bin/python        # CosyVoice3 + 网页
# LVS_PY_VOXCPM=envs/voxcpm/bin/python    # VoxCPM2
# LVS_PY_ASR=envs/asr/bin/python          # Qwen3-ASR（音色截取、字幕识别）
# LVS_FFMPEG_DIR=                         # 带 libass 的 ffmpeg 所在目录（默认 = 主环境 bin）

# ---- 模型 ----
# LVS_MODELS=models
# LVS_COSYVOICE_DIR=third_party/CosyVoice
# LVS_COSYVOICE_MODEL=models/Fun-CosyVoice3-0.5B
# LVS_VOXCPM_MODEL=models/VoxCPM2
# LVS_ASR_MODEL=models/Qwen3-ASR-1.7B
# LVS_ALIGNER_MODEL=models/Qwen3-ForcedAligner-0.6B
# LVS_TN_DIR=models/wetext-zh-tn                 # 数字和单位按中文读的规则文件

# ---- 内置音色（可选，所有人默认可选的声音） ----
# LVS_BUILTIN_VOICE_NAME=张老师
# LVS_BUILTIN_VOICE_WAV=$HOME/voice/prompt.wav    # 10–30 秒参考录音
# LVS_BUILTIN_VOICE_TXT=$HOME/voice/prompt.txt    # 录音对应的文字
